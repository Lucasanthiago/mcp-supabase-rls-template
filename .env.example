# Supabase local (`supabase start` imprime esses valores; `supabase status` mostra de novo)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=cole-a-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# Projeto hosted: a URL e https://<project-ref>.supabase.co e as chaves ficam em
# Project Settings > API.
#
# A SERVICE_ROLE_KEY ignora RLS por completo. Ela e usada aqui em dois lugares e
# so neles: criar os usuarios de teste (seed) e ler as contagens reais que
# servem de controle no teste de isolamento. Nunca commite o .env.

# Endpoint do servidor MCP usado por `npm run test:mcp`. Opcional: o padrao e
# ${SUPABASE_URL}/functions/v1/mcp, que e o que `supabase functions serve mcp` expoe.
# MCP_URL=http://127.0.0.1:54321/functions/v1/mcp
